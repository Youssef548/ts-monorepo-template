# Read by prisma.config.ts. Copy to .env.
#
# Must match the DATABASE_URL in apps/api/.env — scripts/check-db-env.mjs fails
# the migrate commands when they disagree, because the other outcome is
# migrating one database while the API serves a different one, silently.
#
# The credentials match the defaults in docker-compose.yml / the root .env.
DATABASE_URL=postgresql://app:app@localhost:5432/app
