# Copy to .env. The API refuses to boot if any of these are missing or invalid.
APP_NAME=app

# Must match DATABASE_URL in packages/database/.env — scripts/check-db-env.mjs
# fails the migrate commands when they disagree.
DATABASE_URL=postgresql://app:app@localhost:5432/app

PORT=3001
# Comma-separated list of allowed browser origins.
WEB_URL=http://localhost:3000
